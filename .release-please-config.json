{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "tag-separator": "/",
  "pull-request-title-pattern": "chore(release): release ${component} ${version}",
  "label": "autorelease: pending",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Miscellaneous",
      "hidden": true
    }
  ],
  "packages": {
    ".github/actions/resolve-pr": {
      "component": "resolve-pr"
    },
    ".github/actions/semantic-pull-request": {
      "component": "semantic-pull-request"
    },
    ".github/actions/terraform-fmt": {
      "component": "terraform-fmt"
    },
    ".github/actions/terraform-init": {
      "component": "terraform-init"
    },
    ".github/actions/terraform-init-s3": {
      "component": "terraform-init-s3"
    },
    ".github/actions/terraform-lint-scan": {
      "component": "terraform-lint-scan"
    },
    ".github/actions/terraform-plan": {
      "component": "terraform-plan"
    },
    ".github/actions/terraform-release-lock": {
      "component": "terraform-release-lock"
    },
    ".github/actions/terraform-validate": {
      "component": "terraform-validate"
    },
    ".github/actions/tflint": {
      "component": "tflint"
    },
    ".github/actions/check-go-deps": {
      "component": "check-go-deps",
      "initial-version": "0.1.0"
    },
    ".github/actions/check-secret": {
      "component": "check-secret",
      "initial-version": "0.1.0"
    },
    ".github/actions/check-snippet-regions": {
      "component": "check-snippet-regions",
      "initial-version": "0.1.0"
    },
    ".github/actions/create-pr": {
      "component": "create-pr",
      "initial-version": "0.1.0"
    },
    ".github/actions/detect-changes": {
      "component": "detect-changes",
      "initial-version": "0.1.0"
    },
    ".github/actions/docs-build": {
      "component": "docs-build",
      "initial-version": "0.1.0"
    },
    ".github/actions/go-test": {
      "component": "go-test",
      "initial-version": "0.1.0"
    },
    ".github/actions/install-tparse": {
      "component": "install-tparse",
      "initial-version": "0.1.0"
    },
    ".github/actions/setup-go-env": {
      "component": "setup-go-env",
      "initial-version": "0.1.0"
    },
    ".github/actions/vet-go-snippets": {
      "component": "vet-go-snippets",
      "initial-version": "0.1.0"
    },
    ".github/workflows/reusable-build-go.yml": {
      "component": "reusable-build-go",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-check-go-deps.yml": {
      "component": "reusable-check-go-deps",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-check-license.yml": {
      "component": "reusable-check-license",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-check-snippets.yml": {
      "component": "reusable-check-snippets",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-codeql.yml": {
      "component": "reusable-codeql",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-docs-build.yml": {
      "component": "reusable-docs-build",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-docs-gate.yml": {
      "component": "reusable-docs-gate",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-e2e-go.yml": {
      "component": "reusable-e2e-go",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-govulncheck.yml": {
      "component": "reusable-govulncheck",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-lint-go.yml": {
      "component": "reusable-lint-go",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-lint-pr-title.yml": {
      "component": "reusable-lint-pr-title",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-scorecard.yml": {
      "component": "reusable-scorecard",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-stale-issues.yml": {
      "component": "reusable-stale-issues",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-sync-issue-labels.yml": {
      "component": "reusable-sync-issue-labels",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-test-go.yml": {
      "component": "reusable-test-go",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-vale-lint.yml": {
      "component": "reusable-vale-lint",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    },
    ".github/workflows/reusable-zizmor.yml": {
      "component": "reusable-zizmor",
      "initial-version": "0.1.0",
      "separate-pull-requests": false
    }
  }
}
